{
  "name": "react-vite-tailwind",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:api": "node scripts/devApi.mjs",
    "test:ui": "node scripts/uiRenderTest.mjs && node scripts/uiFlowTest.mjs",
    "prebuild": "node scripts/emitRedirects.mjs && node scripts/emitStrategyMd.mjs",
    "build": "vite build",
    "postbuild": "node scripts/stampBuild.mjs && node scripts/urlParity.mjs && node scripts/auditSeo.mjs && node scripts/auditIndexability.mjs && node scripts/auditImages.mjs",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "audit": "node scripts/auditSeo.mjs && node scripts/auditIndexability.mjs && node scripts/auditImages.mjs",
    "verify": "node scripts/verifyRendered.mjs"
  },
  "dependencies": {
    "clsx": "2.1.1",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "react-helmet-async": "^3.0.0",
    "react-router-dom": "^7.18.2",
    "tailwind-merge": "3.4.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "4.1.17",
    "@types/node": "22.19.17",
    "@types/react": "19.2.7",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "5.1.1",
    "jsdom": "^30.0.1",
    "tailwindcss": "4.1.17",
    "typescript": "5.9.3",
    "vite": "7.3.2",
    "vite-plugin-singlefile": "2.3.0"
  }
}
