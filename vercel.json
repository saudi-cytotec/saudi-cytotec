{
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "installCommand": "npm ci",
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=(), interest-cohort=()"
        },
        {
          "key": "X-DNS-Prefetch-Control",
          "value": "off"
        },
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data: https:; connect-src 'self'; frame-ancestors 'none'; base-uri 'self'; form-action 'self'"
        }
      ]
    },
    {
      "source": "/images/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/media/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/admin",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store"
        }
      ]
    },
    {
      "source": "/api/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/blog/cytotec-in-saudi-arabia/",
      "destination": "/service-areas",
      "statusCode": 301
    },
    {
      "source": "/blog/cytotec-in-saudi-arabia",
      "destination": "/service-areas",
      "statusCode": 301
    },
    {
      "source": "/cytotec-saudi-arabia/",
      "destination": "/service-areas",
      "statusCode": 301
    },
    {
      "source": "/https-saudiersaa-com-cytotec-saudi-arabia/",
      "destination": "/service-areas",
      "statusCode": 301
    },
    {
      "source": "/about.html",
      "destination": "/about",
      "statusCode": 301
    },
    {
      "source": "/contact.html",
      "destination": "/contact",
      "statusCode": 301
    },
    {
      "source": "/privacy-policy.html",
      "destination": "/privacy",
      "statusCode": 301
    },
    {
      "source": "/category-care.html",
      "destination": "/womens-health",
      "statusCode": 301
    },
    {
      "source": "/feed",
      "statusCode": 410
    },
    {
      "source": "/feed/",
      "statusCode": 410
    },
    {
      "source": "/blog/cytotec-jazan/",
      "destination": "/service-areas",
      "statusCode": 301
    },
    {
      "source": "/blog/cytotec-jazan",
      "destination": "/service-areas",
      "statusCode": 301
    },
    {
      "source": "/blog/cytotec-baha/",
      "destination": "/service-areas",
      "statusCode": 301
    },
    {
      "source": "/blog/cytotec-baha",
      "destination": "/service-areas",
      "statusCode": 301
    },
    {
      "source": "/blog/cytotec-abha",
      "destination": "/service-areas",
      "statusCode": 301
    },
    {
      "source": "/blog/cytotec-abha/",
      "destination": "/service-areas",
      "statusCode": 301
    },
    {
      "source": "/blog/cytotec-albahah",
      "destination": "/service-areas",
      "statusCode": 301
    },
    {
      "source": "/blog/cytotec-albahah/",
      "destination": "/service-areas",
      "statusCode": 301
    },
    {
      "source": "/blog/cytotec-arar",
      "destination": "/service-areas",
      "statusCode": 301
    },
    {
      "source": "/blog/cytotec-arar/",
      "destination": "/service-areas",
      "statusCode": 301
    }
  ]
}
